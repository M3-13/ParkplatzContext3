{
  "runcontract": 1,
  "services": [
    {
      "name": "parkplatz",
      "dir": "src-tauri",
      "stack": "rust",
      "kind": "cli",
      "install": [
        ["cargo", "install", "tauri-cli", "--locked", "--version", "2"]
      ],
      "build": [
        ["cargo", "tauri", "build"]
      ],
      "start": [
        ["cargo", "tauri", "dev"]
      ]
    }
  ]
}
